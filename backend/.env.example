# ========================================
# AUTHENEX BACKEND - ENVIRONMENT CONFIGURATION
# ========================================
# 
# CRITICAL: Never commit this file with real values to Git!
# This is a template. Copy to .env and fill in your values.

# ===================
#  ENVIRONMENT
# ===================
# Values: development | production
# Production mode enforces stricter security (SSL, CORS restrictions, etc.)
ENVIRONMENT=development

# ===================
#  DATABASE
# ===================
# PostgreSQL connection string (REQUIRED)
# 
# For local development (SQLite):
# DATABASE_URL=sqlite:///./authenex.db
# 
# For production (PostgreSQL with SSL - Neon/Railway/Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
#
# Example (Neon):
# DATABASE_URL=postgresql://authenex_owner:abc123...@ep-xyz-123.us-east-2.aws.neon.tech/authenex?sslmode=require
DATABASE_URL=sqlite:///./authenex.db

# ===================
#  AUTHENTICATION
# ===================
# NextAuth JWT secret (CRITICAL - Must match frontend)
# Generate with: openssl rand -base64 32
# This must be the EXACT same value as NEXTAUTH_SECRET in your frontend .env
NEXTAUTH_SECRET=your-nextauth-secret-here-must-match-frontend

# ===================
#  AI / GEMINI
# ===================
# Google Gemini API Key (REQUIRED)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ===================
#  CORS / NETWORK
# ===================
# Comma-separated list of allowed origins (REQUIRED in production)
# 
# For local development:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
#
# For production:
# ALLOWED_ORIGINS=https://authenex.vercel.app,https://authenex.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===================
#  DEBUGGING
# ===================
# Enable SQL query logging (NOT recommended in production)
# Values: true | false
SQL_DEBUG=false
